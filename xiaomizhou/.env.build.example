# Build-time input only. End users do not need this image or any NapCat settings.
# First run: node scripts/prepare-napcat-image.js (download, SHA-256 verify, docker load).
# Default: pinned v4.18.42 archive, with QQ 3.2.34-53644. No separate service.
# For ARM64: NAPCAT_BUILD_ARCH=arm64 node scripts/prepare-napcat-image.js,
# then change the tag below to 4.18.42-arm64.
NAPCAT_BASE_IMAGE=xiaomizhou/napcat-runtime:4.18.42-amd64
