# Experimental overlay: retain NapCat as an explicit fallback and use its
# checksum-pinned Linux QQ installation. No upstream SnowCat files are patched.
ARG XIAOMIZHOU_BASE_IMAGE
FROM node:24-bookworm-slim AS snowcat-build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ \
    && rm -rf /var/lib/apt/lists/* && npm install -g pnpm@9.15.9
WORKDIR /build
COPY napcat-runtime.lock.json ./
COPY scripts/prepare-snowcat-source.js ./scripts/
RUN node scripts/prepare-snowcat-source.js /source
WORKDIR /source
RUN pnpm install --frozen-lockfile
RUN export NAPCAT_VERSION="$(node -p 'require("/build/napcat-runtime.lock.json").snowcat.version')" \
    && pnpm --filter snowcat-types run build \
    && pnpm run build:webui \
    && pnpm run build:shell
WORKDIR /source/packages/snowcat-shell/dist
RUN npm install --omit=dev --ignore-scripts --no-package-lock express@5.1.0 ws@8.18.3 \
    && mkdir -p defaults && cp config/napcat.json defaults/napcat.json \
    && rm -rf config && cp /source/LICENSE ./LICENSE \
    && printf '%s\n' 'Source: https://github.com/DandanLLab/SnowCatQQ' \
       'Commit: e465fbaf7c66e79161c458b457c897cdae6258b4' > SOURCE.txt \
    && test -f native/napi2native/napi2native.linux.x64.node

FROM ${XIAOMIZHOU_BASE_IMAGE}
COPY --from=snowcat-build /source/packages/snowcat-shell/dist /opt/xiaomizhou-snowcat
ENV QQ_FRAMEWORK=snowcat
